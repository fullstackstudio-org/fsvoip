// TestFlight and App Store builds use production APNs (Xcode sets `aps-environment` to production when it exports
// for distribution). A Release build run straight from Xcode on a phone is development-signed: then put
// `FSVOIP_PUSH_ENV = sandbox` in Local.xcconfig (included by Shared.xcconfig, after this line, so it wins).
FSVOIP_PUSH_ENV = production

#include "Shared.xcconfig"
