<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Self-managed calls through Telecom (our own call screen; no default-dialer role needed). -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <application>
        <!-- Telecom binds to this service for every FSVoip call (plan D16). -->
        <service
            android:name="nl.fullstackstudio.fsvoip.callcontroller.FsConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
